# Docker publishes the app only on this host port and loopback address.
KT_WEB_PORT=8765

# Configure these only for optional Google OIDC mode; no credentials are stored here.
KT_GOOGLE_CLIENT_ID=replace-with-google-web-client-id
KT_GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
KT_PUBLIC_URL=https://your-stable-host.example
# Generate locally with: openssl rand -hex 32
KT_SESSION_SECRET=replace-with-at-least-32-random-bytes

# CPU tuning defaults; use another positive integer for your host.
KT_ECAPA_CPU_THREADS=4
KT_ECAPA_CPU_INTEROP_THREADS=1
